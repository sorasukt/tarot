{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorasukt-api",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.sorasukt.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "SUPPORT_URL": "https://sorasukt.com/tarot/support/",
    "SITE_URL": "https://sorasukt.com",
    "STRIPE_PRICE_SUB_WEEKLY": "",
    "STRIPE_PRICE_SUB_MONTHLY": "",
    "STRIPE_PRICE_SUB_YEARLY": "",
    "STRIPE_PRICE_ONETIME_WEEKLY": "",
    "STRIPE_PRICE_ONETIME_MONTHLY": "",
    "STRIPE_PRICE_ONETIME_YEARLY": "",
    "ALLOWED_ORIGINS": "https://sorasukt.com,https://www.sorasukt.com",
    "AUTH0_DOMAIN": "auth.sorasukt.com",
    "AUTH0_CLIENT_ID": "NbMkuqqsuljnBKcAKVDr8bICryQZR4MI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "91001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 17 * * *"]
  },
  "secrets": {
    "required": ["GEMINI_API_KEY", "AUTH0_CLIENT_SECRET", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
  }
}
